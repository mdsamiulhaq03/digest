DATABASE_URL=postgresql+psycopg://digest:digest@db:5432/digest

# Minimum level written to stdout. DEBUG is useful locally; leave INFO in
# anything shared, since DEBUG pulls in SQLAlchemy's statement logging.
LOG_LEVEL=INFO

# HS256 signing key, at least 32 chars. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Job queue. Only job ids travel through Redis; Postgres holds the jobs.
REDIS_URL=redis://redis:6379/0
# Where uploaded files are written (a named volume shared with the worker).
UPLOAD_DIR=/data/uploads
