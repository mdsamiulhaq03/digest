DATABASE_URL=postgresql+psycopg://digest:digest@db:5432/digest

# Minimum level written to stdout. DEBUG is useful locally; leave INFO in
# anything shared, since DEBUG pulls in SQLAlchemy's statement logging.
LOG_LEVEL=INFO

# HS256 signing key, at least 32 chars. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Job queue. Only job ids travel through Redis; Postgres holds the jobs.
REDIS_URL=redis://redis:6379/0
# Where uploaded files are written (a named volume shared with the worker).
UPLOAD_DIR=/data/uploads

# How long a cached document read lives in Redis (seconds). Defaults to 3600.
# DOCUMENT_CACHE_TTL_SECONDS=3600

# Browser origins allowed to call the API directly, comma-separated exact
# origins (https://app.example.com - no path, no trailing slash). Leave empty:
# the frontend calls the API server-side and needs none. "*" is refused.
# CORS_ORIGINS=

# One-click "log in as demo user / admin" buttons on the login page. Off
# unless set - never turn it on anywhere real. docker-compose.yml turns it on
# for the local stack.
# DEMO_ACCOUNTS=false
